{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "merch-mt",
  "main": "src/_worker.js",
  "compatibility_date": "2026-09-17",
  "routes": [
    {
      "pattern": "merch.mt",
      "custom_domain": true
    },
    {
      "pattern": "www.merch.mt",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  },
  "observability": {
    "enabled": true
  }
}
